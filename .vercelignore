# .vercelignore - Files to exclude from Vercel deployment

# Python cache
__pycache__/
*.pyc
*.pyo
*.egg-info/
.Python

# Virtual environments
.venv/
venv/
env/
ENV/

# IDE & Editor
.vscode/
.idea/
*.swp
*.swo
*~
.DS_Store

# Git
.git/
.gitignore

# Build & Deploy
.vercelignore
build/
dist/

# Data (optional - uncomment if you want to exclude large data files)
# data/
# Resume/

# Environment files (don't include local .env)
.env.local
.env.*.local

# ML models (if too large)
# *.pth
# *.bin
